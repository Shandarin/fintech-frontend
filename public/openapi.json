{
  "openapi": "3.0.3",
  "info": {
    "title": "RegimeLab Frontend Mock Contract",
    "version": "1.0.0",
    "description": "用于前后端对齐的草案。当前由浏览器内函数模拟，不存在真实HTTP服务。线上认证、用户管理、历史查询与写入接口仍需后端协商扩展。"
  },
  "servers": [
    {
      "url": "/",
      "description": "示意地址；当前不是可调用的后端"
    }
  ],
  "paths": {
    "/api/assets": {
      "get": {
        "summary": "查询当前用户可见资产",
        "operationId": "assetsList",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "equity",
                "bond",
                "commodity",
                "fx"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "本地模拟数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "requestId",
                    "mock",
                    "data"
                  ],
                  "properties": {
                    "requestId": {
                      "type": "string"
                    },
                    "mock": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Asset"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效 / 不支持的模拟查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录演示身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "当前演示身份不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "模拟器未定义接口",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "达到本地每分钟调用限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/features": {
      "get": {
        "summary": "查询最新特征",
        "operationId": "featuresList",
        "parameters": [
          {
            "name": "assetId",
