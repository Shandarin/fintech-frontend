    "/graphql": {
      "post": {
        "summary": "只支持预设WorkspaceSnapshot查询",
        "operationId": "workspaceSnapshot",
        "description": "当前前端模拟器不是通用GraphQL解析器；不支持查询形状任意变化。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "工作台聚合结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "requestId",
                    "mock",
                    "data"
                  ],
                  "properties": {
                    "requestId": {
                      "type": "string"
                    },
                    "mock": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "workspace": {
                          "type": "object",
                          "properties": {
                            "assets": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Asset"
                              }
                            },
                            "states": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/RegimeState"
                              }
                            },
                            "unreadAlertCount": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效 / 不支持的模拟查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录演示身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "当前演示身份不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "模拟器未定义接口",
            "content": {
