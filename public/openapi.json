                }
              }
            }
          },
          "429": {
            "description": "达到本地每分钟调用限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新建预警规则（分析师/管理员）",
        "operationId": "ruleCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuleInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "规则写入当前模拟工作区",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "requestId",
                    "mock",
                    "data"
                  ],
                  "properties": {
                    "requestId": {
                      "type": "string"
                    },
                    "mock": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/RuleInput"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效 / 不支持的模拟查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录演示身份",
