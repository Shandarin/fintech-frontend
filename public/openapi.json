    "/api/rules": {
      "get": {
        "summary": "查询当前用户可见规则",
        "operationId": "rulesList",
        "parameters": [],
        "responses": {
          "200": {
            "description": "本地模拟数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "requestId",
                    "mock",
                    "data"
                  ],
                  "properties": {
                    "requestId": {
                      "type": "string"
                    },
                    "mock": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/RuleInput"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效 / 不支持的模拟查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录演示身份",
