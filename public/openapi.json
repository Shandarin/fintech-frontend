  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "requestId",
          "mock",
          "error"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "mock": {
            "type": "boolean",
            "example": true
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "id",
          "name",
          "symbol",
          "category"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "csi300"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "equity",
              "bond",
              "commodity",
              "fx"
            ]
          },
          "latest": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "close": {
                "type": "number"
              },
              "volume": {
                "type": "number"
              }
            }
          }
        }
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "return1d": {
            "type": "number",
            "description": "百分点 / 百分数，非0–1小数"
          },
          "volatility20": {
            "type": "number",
            "description": "百分点 / 百分数，非0–1小数"
          },
          "momentum20": {
            "type": "number",
            "description": "百分点 / 百分数，非0–1小数"
          },
          "drawdown": {
            "type": "number",
            "description": "百分点 / 百分数，非0–1小数"
          },
          "confidence": {
            "type": "number",
            "description": "百分点 / 百分数，非0–1小数"
          }
        }
      },
      "RuleInput": {
        "type": "object",
        "required": [
          "name",
          "assetId",
          "metric",
          "operator",
          "threshold",
          "severity",
          "cooldown"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "assetId": {
            "type": "string",
            "description": "可访问资产ID或all"
          },
          "metric": {
            "type": "string",
            "enum": [
              "return1d",
              "volatility20",
              "momentum20",
              "drawdown",
              "confidence"
            ]
          },
          "operator": {
            "type": "string",
            "enum": [
              "gt",
              "lt"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "cooldown": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "description": "分钟"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "RegimeState": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          },
          "regime": {
            "type": "string",
            "enum": [
              "bull",
              "range",
              "bear"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "未校准的本地演示分数"
          },
          "probabilities": {
            "type": "object",
            "properties": {
              "bull": {
                "type": "number"
              },
              "range": {
                "type": "number"
              },
              "bear": {
                "type": "number"
              }
            }
          },
          "engine": {
            "type": "string",
            "example": "frontend-demo-heuristic"
          },
          "modelMetadata": {
            "type": "string"
          }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "assetId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "acknowledged",
              "resolved"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "threshold": {
            "type": "number"
          },
          "operator": {
            "type": "string"
          },
          "snapshotDate": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}